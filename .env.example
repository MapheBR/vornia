# PostgreSQL
POSTGRES_USER=vornia
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=vornia

# Owner do schema: usado APENAS por migrations/administracao.
DATABASE_URL=postgresql://vornia:change-me-in-production@postgres:5432/vornia

# Roles de runtime (criadas por scripts/provision-db-roles.sql)
VORNIA_APP_PASSWORD=change-me-app-in-production
VORNIA_AUTH_PASSWORD=change-me-auth-in-production

# Runtime do FastAPI: sujeito a RLS (nunca owner, nunca BYPASSRLS).
DATABASE_URL_APP=postgresql://vornia_app:change-me-app-in-production@postgres:5432/vornia

# Bootstrap de tenant (register/login): role com BYPASSRLS.
DATABASE_URL_BOOTSTRAP=postgresql://vornia_auth:change-me-auth-in-production@postgres:5432/vornia

# JWT (gerar com: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Cookies
COOKIE_SECURE=true

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=https://api.vornia.local

# CORS (domínios separados por vírgula)
CORS_ORIGINS=https://vornia.local,https://app.vornia.local
