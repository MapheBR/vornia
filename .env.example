# PostgreSQL
POSTGRES_USER=vornia
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=vornia
DATABASE_URL=postgresql://vornia:change-me-in-production@postgres:5432/vornia

# JWT (gerar com: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Cookies
COOKIE_SECURE=true

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=https://api.vornia.local

# CORS (domínios separados por vírgula)
CORS_ORIGINS=https://vornia.local,https://app.vornia.local
