# PostgreSQL
POSTGRES_USER=vornia
POSTGRES_PASSWORD=vornia_db_9f8a7b6c5d4e3f2a
POSTGRES_DB=vornia

# Owner do schema: usado APENAS por migrations/administracao.
DATABASE_URL=postgresql://vornia:vornia_db_9f8a7b6c5d4e3f2a@postgres:5432/vornia

# Roles de runtime (criadas por scripts/provision-db-roles.sql)
VORNIA_APP_PASSWORD=vornia_app_1a2b3c4d5e6f7g8h
VORNIA_AUTH_PASSWORD=vornia_auth_8h7g6f5e4d3c2b1a

# Runtime do FastAPI: sujeito a RLS (nunca owner, nunca BYPASSRLS).
DATABASE_URL_APP=postgresql://vornia_app:vornia_app_1a2b3c4d5e6f7g8h@postgres:5432/vornia

# Bootstrap de tenant (register/login): role com BYPASSRLS.
DATABASE_URL_BOOTSTRAP=postgresql://vornia_auth:vornia_auth_8h7g6f5e4d3c2b1a@postgres:5432/vornia

# JWT (gerado com segurança para o seu projeto)
JWT_SECRET=4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Cookies
COOKIE_SECURE=true

# Redis
REDIS_URL=redis://redis:6379/0

# IMPORTANTE: Substitua [COLE_O_IP_TAILSCALE_AQUI] pelo IP da sua VM (ex: 100.85.120.40)
NEXT_PUBLIC_API_URL=https://[COLE_O_IP_TAILSCALE_AQUI]
CORS_ORIGINS=https://[COLE_O_IP_TAILSCALE_AQUI]