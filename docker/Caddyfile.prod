{
	# Deploy local (self-hosting + Tailscale): não há domínio público nem
	# porta 80/443 aberta na internet. ACME/desafios HTTP-01 não são usados.
	auto_https off
}

:80 {
	# CSP: `unsafe-inline` é dívida temporária — Next.js 15 usa scripts inline
	# para hidratação (_next_f). Demais diretivas permanecem restritivas.
	# HSTS não é enviado em HTTP puro: o tráfego já é cifrado pelo Tailscale.
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
