{
	# Variante HTTPS opcional para o deploy local. Use somente quando tiver
	# um certificado emitido pelo Tailscale (`tailscale cert <nome>.ts.net`).
	# Troque o volume do Caddy em docker-compose.local.yml por este arquivo e
	# defina VORNIA_TLS_CERT / VORNIA_TLS_KEY no .env.
	auto_https off
}

# HTTP continua disponível na rede do Tailscale (porta publicada 8080) e
# redireciona para o nome MagicDNS na porta 8443.
:80 {
	# O placeholder de host inclui a porta (ex.: 100.x.y.z:8080), o que
	# geraria uma URL invalida com :8443 duplicado. Use o nome do MagicDNS.
	redir https://{$VORNIA_DOMAIN}:8443{uri} permanent
}

:443 {
	# Certificado *.ts.net: sem Let's Encrypt e sem exposição à internet.
	tls {$VORNIA_TLS_CERT} {$VORNIA_TLS_KEY}

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains" always
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
